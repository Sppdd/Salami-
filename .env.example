# ---------- Nebius Token Factory (required) ----------
# Create a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model tiers — copy exact IDs from the Token Factory model catalog.
# Fast tier: every live conversation turn (latency matters most)
NEMOTRON_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Smart tier: reschedule negotiation / tricky turns the fast tier flags
NEMOTRON_SMART_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
# Reasoning tier: post-call analysis + business insights reports
NEMOTRON_REASONING_MODEL=nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B
# Ask Nemotron chat templates to skip <think> on the fast tier (set false if your endpoint rejects it)
NEMOTRON_DISABLE_THINKING_FAST=true

# ---------- Supabase (required) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Twilio (optional — browser call simulator works without it) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Voice for <Say>; any Twilio/Amazon Polly voice
TWILIO_VOICE=Polly.Joanna-Neural

# ---------- Server ----------
PORT=8080
# Public https URL of this server (Twilio webhooks call back here)
PUBLIC_URL=http://localhost:8080
# Comma-separated allowed browser origins in dev (the built web app is served same-origin)
CORS_ORIGINS=http://localhost:5173
# Max simultaneous outbound phone calls per campaign run
CAMPAIGN_CONCURRENCY=2

# ---------- Web (Vite, exposed to the browser) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Leave empty when the web app is served by the server (same origin)
VITE_API_URL=http://localhost:8080
